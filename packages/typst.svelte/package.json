{
	"name": "@myriaddreamin/typst.svelte",
	"version": "0.8.0-rc4",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package",
		"publish:dry": "npm publish --dry-run --access public",
		"publish:lib": "npm publish --access public || exit 0",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "playwright test"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "5.53.5",
		"@myriaddreamin/typst-ts-renderer": "0.8.0-rc4",
		"@myriaddreamin/typst-ts-web-compiler": "0.8.0-rc4",
		"@myriaddreamin/typst.ts": "0.8.0-rc4"
	},
	"devDependencies": {
		"@myriaddreamin/typst-ts-renderer": "0.8.0-rc4",
		"@myriaddreamin/typst-ts-web-compiler": "0.8.0-rc4",
		"@myriaddreamin/typst.ts": "0.8.0-rc4",
		"playwright": "1.54.1",
		"typescript": "5.9.3",
		"vite": "7.3.1",
		"@sveltejs/adapter-auto": "7.0.1",
		"@sveltejs/kit": "2.53.3",
		"@sveltejs/package": "2.5.7",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"svelte": "5.53.5",
		"svelte-check": "4.4.4"
	},
	"keywords": [
		"svelte"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Myriad-Dreamin/typst.ts"
	}
}
