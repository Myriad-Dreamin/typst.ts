{
  "name": "reflexo-workspace",
  "version": "0.8.0-rc4",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "author": "Myriad-Dreamin",
  "description": "Run Typst in JavaScriptWorld.",
  "license": "Apache-2.0",
  "keywords": [
    "TypeScript",
    "Typst"
  ],
  "bugs": "https://github.com/Myriad-Dreamin/typst.ts/issues",
  "homepage": "https://myriad-dreamin.github.io/typst.ts/",
  "private": true,
  "workspaces": [
    "packages/parser",
    "packages/compiler",
    "packages/ng/compiler",
    "packages/renderer",
    "packages/typst.ts",
    "packages/typst.node",
    "packages/typst.react",
    "packages/typst.solid",
    "packages/typst.solid/demo",
    "packages/typst.vue3",
    "packages/typst.svelte",
    "packages/typst.angular",
    "packages/typst-all-in-one.ts",
    "templates/*",
    "projects/rehype-typst",
    "projects/hexo-renderer-typst",
    "projects/highlighter",
    "projects/vite-plugin-typst"
  ],
  "scripts": {
    "dev": "cargo build --locked --bin typst-ts-dev-server && yarn dev:run",
    "dev:run": "target/debug/typst-ts-dev-server run http --corpus ./fuzzers/corpora/",
    "corpus": "cargo run --locked --release --bin typst-ts-dev-server -- compile corpus --cat foundations,html,introspection,layout,loading,math,model,pdf,pdftags,playground,scripting,styling,symbols,syntax,text,visualize,lint,viewers,skyzh-cv",
    "install:pure": "yarn install --frozen-lockfile",
    "postinstall": "node scripts/fix-hoisted-typescript-link.mjs",
    "build:core": "yarn workspace @myriaddreamin/typst.ts build",
    "build:pkg": "turbo build --filter=./packages/*",
    "build:renderer": "turbo build --filter=!./packages/{compiler} --filter=./packages/{renderer,typst.ts}",
    "build:proj": "turbo build --filter=./projects/*",
    "build:test": "turbo test test:e2e --filter=./packages/*",
    "watch:renderer": "cargo run --locked --bin typst-ts-dev-server -- watch renderer",
    "start:react": "yarn workspace @myriaddreamin/typst.react dev",
    "start:angular": "yarn workspace typst.angular start",
    "docs": "shiroa serve --font-path assets/fonts -w . docs/cookery",
    "docs:html": "yarn docs --mode static-html",
    "bump-packages": "python scripts/bump_version.py",
    "prepublish-packages": "turbo run prepublish --filter=./packages/*",
    "publish:dry": "turbo run prepublish publish:dry --filter=./packages/*",
    "publish:lib": "turbo run prepublish publish:lib --filter=./packages/*",
    "notes:clone-proj": "assets/fonts is the dummy project for cmd, and you should specify a project for cloning",
    "example:clone-proj": "yarn run clone-proj projects/typst-book",
    "clone-proj": "git submodule update --init --checkout assets/fonts",
    "draft-release": "node scripts/draft-release.mjs",
    "md": "yarn run md0 && yarn run md1 && yarn run md2 && yarn run md3",
    "md0": "cargo run --locked --bin typst-ts-cli -- compile --workspace . --entry ./github-pages/docs/ir-features.typ --format=svg",
    "md1": "cargo run --locked --bin typst-ts-cli -- compile --workspace . --entry ./github-pages/docs/ir-features.dark.typ --format=svg",
    "md2": "cargo run --locked --bin typst-ts-cli -- compile --workspace . --entry ./github-pages/docs/data-flow-standalone.typ --format=svg",
    "md3": "cargo run --locked --bin typst-ts-cli -- compile --workspace . --entry ./github-pages/docs/data-flow-standalone.dark.typ --format=svg"
  },
  "optionalDependencies": {
    "@napi-rs/cross-toolchain-x64-target-armv7": "0.0.19"
  },
  "devDependencies": {
    "@babel/runtime": "7.27.6",
    "@eslint-community/eslint-plugin-eslint-comments": "3.2.1",
    "@napi-rs/cli": "3.0.0-alpha.70",
    "@swc-node/register": "1.10.10",
    "@types/node": "24.6.2",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/browser": "4.0.0-beta.16",
    "@vitest/browser-playwright": "4.0.0-beta.16",
    "@vitest/ui": "4.0.0-beta.16",
    "@xmldom/xmldom": "0.9.8",
    "ava": "6.4.1",
    "cross-env": "7.0.3",
    "emnapi": "1.3.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-html": "7.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.3",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "image-hash": "6.0.1",
    "playwright": "1.54.1",
    "pngjs": "7.0.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-banner": "0.8.1",
    "vitest": "4.0.0-beta.16"
  }
}
